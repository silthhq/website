<% content_for :title, "Silth — " + t("hero.eyebrow") %>
<main>
  <section class="hero">
    <div class="glyph-wrap"><img class="glyph" src="/logo.svg" alt="Silth" width="120" height="120"></div>
    <p class="eyebrow"><%= t("hero.eyebrow") %></p>
    <h1 class="display"><%== t("hero.title") %></h1>
    <p class="lead"><%= t("hero.lead") %></p>
    <div class="actions">
      <a class="btn btn-glow" href="/docs/getting-started/introduction"><%= t("hero.cta") %></a>
      <a class="btn" href="#features"><%= t("hero.cta2") %></a>
    </div>
    <div class="install" data-copy="<%= Site::Samples::INSTALL %>" data-copied="<%= t("hero.copied") %>">
      <span class="prompt">$</span> <code><%= Site::Samples::INSTALL %></code> <button type="button" aria-label="Copy">⧉</button>
    </div>
  </section>

  <section class="stats">
    <div><b>0</b><span><%= t("stats.deps") %></span></div>
    <div><b>3</b><span><%= t("stats.drivers") %></span></div>
    <div><b>35+</b><span><%= t("stats.modules") %></span></div>
    <div><b>1</b><span><%= t("stats.binary") %></span></div>
  </section>

  <section class="section showcase">
    <h2 class="title"><%= t("showcase.title") %></h2>
    <p class="section-lead"><%= t("showcase.lead") %></p>
    <div class="tabs" data-tabs>
      <div class="tab-list" role="tablist">
        <button role="tab" aria-selected="true" data-tab="routes"><%= t("showcase.routes") %></button>
        <button role="tab" aria-selected="false" data-tab="model"><%= t("showcase.model") %></button>
        <button role="tab" aria-selected="false" data-tab="controller"><%= t("showcase.controller") %></button>
        <button role="tab" aria-selected="false" data-tab="live"><%= t("showcase.live") %></button>
      </div>
      <div class="tab-panel" data-panel="routes"><%= code(Site::Samples::ROUTES) %></div>
      <div class="tab-panel" data-panel="model" hidden><%= code(Site::Samples::MODEL) %></div>
      <div class="tab-panel" data-panel="controller" hidden><%= code(Site::Samples::CONTROLLER) %></div>
      <div class="tab-panel" data-panel="live" hidden><%= code(Site::Samples::LIVE) %></div>
    </div>
  </section>

  <section class="section" id="features">
    <h2 class="title"><%= t("features.title") %></h2>
    <p class="section-lead"><%= t("features.lead") %></p>
    <div class="feature-groups">
      <% Site::Features::GROUPS.each do |group, items| %>
        <div class="feature-group">
          <h3><%= t("groups.#{group}") %></h3>
          <ul>
            <% items.each do |item| %>
              <li><b><%= item.name %></b><span><%= locale == "fr" ? item.fr : item.en %></span></li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </section>

  <section class="section split" id="ai">
    <div>
      <h2 class="title"><%= t("ai.title") %></h2>
      <p class="section-lead left"><%= t("ai.lead") %></p>
      <ul class="checks">
        <li><%= t("ai.agents") %></li>
        <li><%= t("ai.skills") %></li>
        <li><%= t("ai.llms") %></li>
        <li><%= t("ai.json") %></li>
      </ul>
    </div>
    <div class="terminal">
      <div class="terminal-bar"><i></i><i></i><i></i></div>
<pre><span class="tok-comment"># an agent exploring your app</span>
<span class="tok-keyword">$</span> silth routes --json | jq '.[0]'
{ "method": "GET", "path": "/posts/:id",
  "name": "posts.show", "handler": "PostsController#show" }

<span class="tok-keyword">$</span> curl -s https://silth.dev/llms.txt | head -3
# Silth
&gt; Silth is a batteries-included MVC web framework…

<span class="tok-keyword">$</span> cat AGENTS.md CLAUDE.md .claude/skills/silth/SKILL.md</pre>
    </div>
  </section>

  <section class="section demo" id="demo">
    <h2 class="title"><%= t("demo.title") %></h2>
    <p class="section-lead"><%= t("demo.lead") %></p>
    <%= live ForgeComponent %>
  </section>

  <section class="section final">
    <h2 class="display small"><%= t("cta.title") %></h2>
    <p class="lead"><%= t("cta.lead") %></p>
    <%= code("silth new my_app --db=postgres\ncd my_app && shards install\nsilth g scaffold Post title:string 'body:text?'\nsilth db:migrate && silth serve", "bash") %>
    <a class="btn btn-glow" href="/docs/getting-started/quickstart">Quickstart →</a>
  </section>
</main>
